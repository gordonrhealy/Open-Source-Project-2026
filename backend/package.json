{
  "name": "finova-backend",
  "version": "3.0.0",
  "description": "Finova Backend - Financial Management Platform API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "package:win": "pkg . --targets node18-win-x64 --output ../release/Finova.exe"
  },
  "keywords": [
    "finance",
    "budget",
    "tracking",
    "mtu"
  ],
  "authors": [
    "Mofazzal Hossain",
    "Gordan Healy"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      ".env.example"
    ],
    "scripts": [
      "*.js",
      "config/**/*.js",
      "models/**/*.js",
      "routes/**/*.js",
      "utils/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "../release"
  }
}